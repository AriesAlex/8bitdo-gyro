{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8bitdo gyro",
  "version": "0.1.0",
  "identifier": "io.github.ariesalex.eightbitdo-gyro",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "8bitdo gyro",
      "width": 840,
      "height": 720,
      "resizable": false,
      "center": true,
      "theme": "Dark",
      "backgroundColor": "#19191d"
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "shortDescription": "Gyroscope settings for 8BitDo Ultimate 3 Xbox",
    "category": "Utility"
  }
}
